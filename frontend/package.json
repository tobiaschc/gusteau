{
  "name": "gusteau-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:python": "cd .. && uv run python frontend/scripts/build_pyodide.py",
    "dev:mobile": "npm run build:python && vite --host --mode mobile",
    "build:mobile": "npm run build:python && tsc --noEmit && vite build --mode mobile",
    "preview": "vite preview",
    "gen:api": "cd .. && uv run python -m gusteau.api.openapi > frontend/openapi.json && cd frontend && npx --yes openapi-typescript@7.13.0 openapi.json -o src/lib/api.gen.ts",
    "lint": "oxlint --deny-warnings src"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "clsx": "^2.1.1",
    "lucide-react": "^1.49.0",
    "pyodide": "314.0.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "oxlint": "^1.86.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
